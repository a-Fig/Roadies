# Copy to .env (git-ignored). Everything is optional for local development:
# with no .env, the server uses a local `livekit-server --dev` and the fake recognizer.

# --- LiveKit (LiveKit Cloud project settings -> Keys) ---
# LIVEKIT_URL=wss://your-project.livekit.cloud
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=
# Only if phones reach LiveKit at a different URL than this server does:
# PUBLIC_LIVEKIT_URL=

# --- Voice commands ---
# google = Google Speech-to-Text (uses Application Default Credentials:
#   gcloud auth application-default login)
# fake   = hears nothing; inject transcripts with POST /dev/say
# RECOGNIZER=google
# GOOGLE_STT_MODEL=command_and_search
# Print every transcript the listener hears (debugging only):
# LOG_TRANSCRIPTS=1

# --- Presenter ---
# The projector view is /presenter?key=<PRESENTER_KEY>
# PRESENTER_KEY=demo

# --- Misc ---
# PORT=8080
# LISTENER=off        # don't join rooms with the command listener
# DEV_ENDPOINTS=1     # /dev/say, /dev/state, /dev/reset (on by default outside production)
